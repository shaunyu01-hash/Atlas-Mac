{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "files": {
    "includes": ["apps/api/**", "apps/web/**", "packages/**", "!**/dist", "!**/drizzle", "!**/routeTree.gen.ts"]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "rules": {
      "recommended": true
    }
  }
}
